{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "knizhnik",
  "version": "0.2.0",
  "identifier": "com.knizhnik.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Книжник",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/covers/*"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Jkaotlic/knizhnik/releases/latest/download/latest.json"
      ],
      "_ЧТОБЫ_ВКЛЮЧИТЬ_ОБНОВЛЕНИЯ": "1) npm run tauri signer generate -- -w ~/.tauri/knizhnik.key  2) публичный ключ вписать в pubkey ниже  3) createUpdaterArtifacts поставить true",
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
